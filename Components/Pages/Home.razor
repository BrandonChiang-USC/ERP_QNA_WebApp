@page "/"
@rendermode InteractiveServer
@inject QnAService QnAService
@inject IToastService ToastService
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>ERP Q&A 維護作業</PageTitle>

<FluentGrid Spacing="3">
    @* Left Column *@
    <FluentGridItem xs="12" md="6" Style="display: flex; flex-direction: column;">
        <div style="display: flex; flex-direction: column; height: 100%;">
            @* Input Section *@
            <FluentCard Style="margin-bottom: 16px; flex: 1;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <h4>@(isEditing ? "編輯 Q&A" : "新增 Q&A")</h4>

                    <FluentTextField @bind-Value="currentQnA.Question"
                                     Label="問題"
                                     Placeholder="輸入問題..."
                                     Style="width: 100%;"
                                     AutoComplete="off" />

                    <FluentTextArea @bind-Value="currentQnA.Answer"
                                    Label="答案"
                                    Placeholder="輸入答案..."
                                    Rows="4"
                                    Style="width: 100%;" />

                    <div style="width: 100%;">
                        <label style="display: block; margin-bottom: 4px; font-weight: 600;">標籤</label>
                        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" HorizontalGap="5" Style="margin-bottom: 8px;">
                            @foreach (var tag in currentTags)
                            {
                                <FluentBadge Appearance="Appearance.Neutral" Style="padding: 4px 8px; display: flex; align-items: center; gap: 4px;">
                                    @tag
                                    <FluentButton Appearance="Appearance.Lightweight" 
                                                  OnClick="@(() => RemoveTag(tag))"
                                                  Style="padding: 0; width: 16px; height: 16px; min-width: 16px; border-radius: 50%;">
                                        ✕
                                    </FluentButton>
                                </FluentBadge>
                            }
                        </FluentStack>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                            <FluentSelect @bind-Value="selectedTag" 
                                          Style="flex: 1;"
                                          Items="@availableTags"
                                          OptionText="@(t => t)"
                                          OptionValue="@(t => t)"
                                          Placeholder="選擇標籤...">
                            </FluentSelect>
                            <FluentButton Appearance="Appearance.Outline" OnClick="AddSelectedTag" Disabled="@string.IsNullOrEmpty(selectedTag)">
                                加入
                            </FluentButton>
                        </FluentStack>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5" Style="margin-top: 5px;">
                            <FluentTextField @bind-Value="newTag" 
                                             Placeholder="或輸入新標籤(輸入後要按新增才會生效)..."
                                             Style="flex: 1;"
                                             AutoComplete="off"
                                             @onkeydown="HandleTagKeyDown" />
                            <FluentButton Appearance="Appearance.Outline" OnClick="AddNewTag" Disabled="@string.IsNullOrEmpty(newTag)">
                                新增
                            </FluentButton>
                        </FluentStack>
                    </div>

                    <FluentTextField @bind-Value="currentQnA.Remark"
                                     Label="備註"
                                     Placeholder="Additional notes..."
                                     Style="width: 100%;"
                                     AutoComplete="off" />

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="width: 100%;">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10">
                            <FluentButton Appearance="Appearance.Accent" OnClick="SaveQnA" Disabled="@isSaving">
                                @(isEditing ? "修改" : "新增")
                            </FluentButton>
                            @if (isEditing)
                            {
                                <FluentButton Appearance="Appearance.Outline" OnClick="CancelEdit">
                                    取消
                                </FluentButton>
                            }
                        </FluentStack>
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10">
                            <FluentButton Appearance="Appearance.Outline" OnClick="GenerateTemplate" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowDownload())">
                                產生範本
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Outline" OnClick="OpenImportDialog" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ArrowUpload())">
                                上傳 Excel
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                </FluentStack>
            </FluentCard>

            @* Query Section *@
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <h4>搜尋 Q&A</h4>

                    <FluentTextField @bind-Value="searchKeyword"
                                     Label="關鍵字"
                                     Placeholder="在問題、答案、備註中搜尋..."
                                     Style="width: 100%;"
                                     AutoComplete="off" />

                    <FluentTextField @bind-Value="searchTags"
                                     Label="標籤"
                                     Placeholder="以標籤篩選..."
                                     Style="width: 100%;"
                                     AutoComplete="off" />

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10">
                        <FluentButton Appearance="Appearance.Accent" OnClick="SearchQnA" Disabled="@isSearching">
                            搜尋
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="ClearSearch">
                            清除
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Outline" OnClick="LoadAll">
                            顯示全部
                        </FluentButton>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </div>
    </FluentGridItem>

    @* Results Section - Right Column *@
    <FluentGridItem xs="12" md="6" Style="display: flex; flex-direction: column;">
        <FluentCard Style="height: 100%; display: flex; flex-direction: column;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Style="height: 100%;">
                <h4>結果 (@qnaList.Count 筆)</h4>

                @if (isLoading)
                {
                    <FluentProgressRing />
                }
                else if (qnaList.Count == 0)
                {
                    <FluentMessageBar Intent="@MessageIntent.Info">
                        尚無 Q&A 紀錄。請新增或從 Excel 匯入。
                    </FluentMessageBar>
                }
                else
                {
                    <div style="overflow: auto; flex: 1;">
                        <FluentDataGrid Items="@qnaList.AsQueryable()" 
                                        ResizableColumns="true" 
                                        ShowHover="true"
                                        Style="width: 100%;">
                            <PropertyColumn Property="@(q => q.Id)" Title="ID" Width="60px" />
                            <TemplateColumn Title="問題">
                                <div @ondblclick="@(() => EditQnAAsync(context))" @ondblclick:preventDefault="true" style="cursor: pointer; user-select: none;">
                                    @context.Question
                                </div>
                            </TemplateColumn>
                            <TemplateColumn Title="答案">
                                <div @ondblclick="@(() => EditQnAAsync(context))" @ondblclick:preventDefault="true" style="cursor: pointer; user-select: none;">
                                    @context.Answer
                                </div>
                            </TemplateColumn>
                            <TemplateColumn Title="標籤" Width="120px">
                                <div @ondblclick="@(() => EditQnAAsync(context))" @ondblclick:preventDefault="true" style="cursor: pointer; user-select: none;">
                                    @context.Tags
                                </div>
                            </TemplateColumn>
                            <TemplateColumn Title="備註" Width="120px">
                                <div @ondblclick="@(() => EditQnAAsync(context))" @ondblclick:preventDefault="true" style="cursor: pointer; user-select: none;">
                                    @context.Remark
                                </div>
                            </TemplateColumn>
                            <TemplateColumn Title="操作" Width="120px">
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="5">
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Title="編輯"
                                                  OnClick="@(async () => await EditQnAAsync(context))">
                                        編輯
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Title="刪除"
                                                  OnClick="@(async () => await DeleteQnAAsync(context))">
                                        刪除
                                    </FluentButton>
                                </FluentStack>
                            </TemplateColumn>
                        </FluentDataGrid>
                    </div>
                }
            </FluentStack>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

@* Import Dialog *@
<FluentDialog @bind-Hidden="@isImportDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader ShowDismiss="true">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <h4 style="margin: 0;">匯入 Excel</h4>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="15">
            <p style="margin: 0; color: var(--neutral-foreground-hint);">
                上傳包含以下欄位的 Excel 檔案：<strong>問題、答案、標籤、備註</strong>
            </p>
            <div class="file-upload-area">
                <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls" />
                <p>Drag file here or click to browse</p>
            </div>
            @if (isUploading)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" VerticalAlignment="VerticalAlignment.Center">
                    <FluentProgressRing Style="width: 24px; height: 24px;" />
                    <span>Uploading...</span>
                </FluentStack>
            }
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" OnClick="CloseImportDialog">
            Close
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@* Delete Confirmation Dialog *@
<FluentDialog @bind-Hidden="@isDeleteDialogHidden" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader ShowDismiss="true">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <h4 style="margin: 0;">確認刪除</h4>
        </FluentStack>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="15">
            <p style="margin: 0;">您確定要刪除這筆 Q&A 資料嗎？</p>
            @if (qnaToDelete != null)
            {
                <div style="padding: 10px; background-color: var(--neutral-layer-2); border-radius: 4px;">
                    <p style="margin: 0 0 5px 0;"><strong>問題：</strong>@qnaToDelete.Question</p>
                    <p style="margin: 0;"><strong>答案：</strong>@(qnaToDelete.Answer.Length > 100 ? qnaToDelete.Answer.Substring(0, 100) + "..." : qnaToDelete.Answer)</p>
                </div>
            }
            <p style="margin: 0; color: var(--error-color);"><strong>此操作無法復原！</strong></p>
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Outline" OnClick="CancelDelete">
            取消
        </FluentButton>
        <FluentButton Appearance="Appearance.Accent" OnClick="ConfirmDelete" Disabled="@isDeleting">
            @if (isDeleting)
            {
                <FluentProgressRing Style="width: 16px; height: 16px;" />
                <span style="margin-left: 8px;">刪除中...</span>
            }
            else
            {
                <span>確認刪除</span>
            }
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private List<QnA> qnaList = new();
    private QnA currentQnA = new();
    private string searchKeyword = string.Empty;
    private string searchTags = string.Empty;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool isSearching = false;
    private bool isEditing = false;
    private bool isUploading = false;
    private bool isImportDialogHidden = true;
    private bool isDeleteDialogHidden = true;
    private bool isDeleting = false;
    private QnA? qnaToDelete = null;

    // 標籤管理
    private List<string> currentTags = new();
    private string selectedTag = string.Empty;
    private string newTag = string.Empty;
    private List<string> availableTags = new() {  };

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private void AddSelectedTag()
    {
        if (!string.IsNullOrWhiteSpace(selectedTag) && !currentTags.Contains(selectedTag))
        {
            currentTags.Add(selectedTag);
            selectedTag = string.Empty;
        }
    }

    private void AddNewTag()
    {
        if (!string.IsNullOrWhiteSpace(newTag) && !currentTags.Contains(newTag))
        {
            currentTags.Add(newTag);
            if (!availableTags.Contains(newTag))
            {
                availableTags.Add(newTag);
            }
            newTag = string.Empty;
        }
    }

    private void RemoveTag(string tag)
    {
        currentTags.Remove(tag);
    }

    private void HandleTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newTag))
        {
            AddNewTag();
        }
    }

    private async Task GenerateTemplate()
    {
        var headers = new[] { "問題", "答案", "標籤", "備註" };
        using var workbook = new ClosedXML.Excel.XLWorkbook();
        var worksheet = workbook.Worksheets.Add("QnA_Template");
        for (int i = 0; i < headers.Length; i++)
        {
            worksheet.Cell(1, i + 1).Value = headers[i];
            worksheet.Cell(1, i + 1).Style.Font.Bold = true;
        }
        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        stream.Position = 0;

        var buffer = stream.ToArray();
        var base64 = Convert.ToBase64String(buffer);
        var fileName = "QnA_Import_Template.xlsx";
        var url = $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}";

        await JS.InvokeVoidAsync("downloadFile", url, fileName);
    }

    private void OpenImportDialog()
    {
        isImportDialogHidden = false;
    }

    private void CloseImportDialog()
    {
        isImportDialogHidden = true;
    }

    private async Task LoadAll()
    {
        isLoading = true;
        try
        {
            qnaList = await QnAService.GetAllAsync();
            
            // 收集所有已存在的標籤
            var existingTags = qnaList
                .Where(q => !string.IsNullOrWhiteSpace(q.Tags))
                .SelectMany(q => q.Tags!.Split(',').Select(t => t.Trim()))
                .Where(t => !string.IsNullOrEmpty(t))
                .Distinct()
                .OrderBy(t => t)
                .ToList();
            
            // 合併預設標籤和已存在的標籤
            var defaultTags = new List<string> {  };
            availableTags = defaultTags.Union(existingTags).Distinct().OrderBy(t => t).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchQnA()
    {
        isSearching = true;
        try
        {
            qnaList = await QnAService.SearchAsync(searchKeyword, searchTags);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Search failed: {ex.Message}");
        }
        finally
        {
            isSearching = false;
        }
    }

    private void ClearSearch()
    {
        searchKeyword = string.Empty;
        searchTags = string.Empty;
    }

    private async Task SaveQnA()
    {
        if (string.IsNullOrWhiteSpace(currentQnA.Question) || string.IsNullOrWhiteSpace(currentQnA.Answer))
        {
            ToastService.ShowWarning("Question and Answer are required.");
            return;
        }

        // 將標籤列表轉換為字串
        currentQnA.Tags = string.Join(", ", currentTags);

        isSaving = true;
        try
        {
            if (isEditing)
            {
                await QnAService.UpdateAsync(currentQnA);
                ToastService.ShowSuccess("Q&A updated successfully.");
            }
            else
            {
                await QnAService.CreateAsync(currentQnA);
                ToastService.ShowSuccess("Q&A added successfully.");
            }
            currentQnA = new();
            currentTags.Clear();
            isEditing = false;
            await LoadAll();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to save: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task EditQnAAsync(QnA qna)
    {
        currentQnA = new QnA
        {
            Id = qna.Id,
            Question = qna.Question,
            Answer = qna.Answer,
            Tags = qna.Tags,
            Remark = qna.Remark
        };
        
        // 將標籤字串轉換為列表
        currentTags = string.IsNullOrWhiteSpace(qna.Tags) 
            ? new List<string>() 
            : qna.Tags.Split(',').Select(t => t.Trim()).Where(t => !string.IsNullOrEmpty(t)).ToList();
        
        isEditing = true;
        return Task.CompletedTask;
    }

    private void CancelEdit()
    {
        currentQnA = new();
        currentTags.Clear();
        isEditing = false;
    }

    private Task DeleteQnAAsync(QnA qna)
    {
        qnaToDelete = qna;
        isDeleteDialogHidden = false;
        return Task.CompletedTask;
    }

    private void CancelDelete()
    {
        isDeleteDialogHidden = true;
        qnaToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (qnaToDelete == null) return;

        isDeleting = true;
        try
        {
            var result = await QnAService.DeleteAsync(qnaToDelete.Id);
            if (result)
            {
                ToastService.ShowSuccess("Q&A deleted successfully.");
                await LoadAll();
                isDeleteDialogHidden = true;
                qnaToDelete = null;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to delete: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        isUploading = true;
        StateHasChanged();

        try
        {
            var file = e.File;
            if (file == null)
            {
                ToastService.ShowWarning("No file selected.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var qnas = ParseExcel(memoryStream);
            if (qnas.Count > 0)
            {
                var count = await QnAService.ImportFromExcelAsync(qnas);
                ToastService.ShowSuccess($"Successfully imported {count} Q&A records.");
                await LoadAll();
                CloseImportDialog();
            }
            else
            {
                ToastService.ShowWarning("No valid data found in Excel file.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Import failed: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }

    private List<QnA> ParseExcel(Stream stream)
    {
        var qnas = new List<QnA>();

        using var workbook = new ClosedXML.Excel.XLWorkbook(stream);
        var worksheet = workbook.Worksheets.First();
        var rows = worksheet.RangeUsed()?.RowsUsed().Skip(1); // Skip header row

        if (rows == null) return qnas;

        foreach (var row in rows)
        {
            var question = row.Cell(1).GetString()?.Trim();
            var answer = row.Cell(2).GetString()?.Trim();
            var tags = row.Cell(3).GetString()?.Trim();
            var remark = row.Cell(4).GetString()?.Trim();

            if (!string.IsNullOrEmpty(question) && !string.IsNullOrEmpty(answer))
            {
                qnas.Add(new QnA
                {
                    Question = question,
                    Answer = answer,
                    Tags = tags,
                    Remark = remark
                });
            }
        }

        return qnas;
    }
}
